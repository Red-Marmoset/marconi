# EditorConfig for Game Engine Project
# https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C++ files
[*.{cpp,h,hpp,c,cc,cxx}]
indent_style = space
indent_size = 4
max_line_length = 120

# Spacing rules for C++
cpp_space_after_keywords_in_control_flow_statements = true
cpp_space_within_parameter_list_parentheses = false
cpp_space_between_empty_parameter_list_parentheses = false
cpp_space_after_keywords = false
cpp_space_before_function_open_parenthesis = false
cpp_space_within_cast_parentheses = false
cpp_space_within_expression_parentheses = false
cpp_space_before_lambda_open_parenthesis = false
cpp_space_within_initializer_list_braces = true
cpp_space_preserve_in_initializer_list = true

# Brace style
cpp_new_line_before_open_brace_namespace = new_line
cpp_new_line_before_open_brace_type = new_line
cpp_new_line_before_open_brace_function = new_line
cpp_new_line_before_open_brace_block = new_line
cpp_new_line_before_open_brace_lambda = new_line

# Indentation
cpp_indent_braces = false
cpp_indent_multi_line_relative_to = innermost_parenthesis
cpp_indent_within_parentheses = align_to_parenthesis
cpp_indent_preserve_within_parentheses = true
cpp_indent_case_labels = false
cpp_indent_case_contents = true
cpp_indent_case_contents_when_block = false
cpp_indent_lambda_braces_when_parameter = true
cpp_indent_goto_labels = one_left
cpp_indent_preprocessor = leftmost_column
cpp_indent_access_specifiers = false
cpp_indent_namespace_contents = true
cpp_indent_preserve_comments = false

# CMake files
[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.cmake]
indent_style = space
indent_size = 4

# Markdown files
[*.md]
indent_style = space
indent_size = 2
max_line_length = off
trim_trailing_whitespace = false

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# XML files
[*.{xml,vcxproj,vcxproj.filters,props}]
indent_style = space
indent_size = 2

# Shader files
[*.{glsl,hlsl,vert,frag,geom,comp,tesc,tese}]
indent_style = space
indent_size = 4

# Python files (for build scripts)
[*.py]
indent_style = space
indent_size = 4

# Ruby files (for build scripts)
[*.rb]
indent_style = space
indent_size = 4

# Batch/Shell scripts
[*.{bat,sh}]
indent_style = space
indent_size = 2

# Makefiles
[Makefile]
indent_style = tab
