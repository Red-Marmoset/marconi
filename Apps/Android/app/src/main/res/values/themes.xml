<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Marconi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/marconi_accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/marconi_selection</item>
        <item name="colorOnPrimaryContainer">@color/marconi_text</item>
        <item name="colorSecondary">@color/marconi_muted</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/marconi_selection</item>
        <item name="colorOnSecondaryContainer">@color/marconi_text</item>
        <item name="android:colorBackground">@color/marconi_background</item>
        <item name="colorOnBackground">@color/marconi_text</item>
        <item name="colorSurface">@color/marconi_surface</item>
        <item name="colorOnSurface">@color/marconi_text</item>
        <item name="colorSurfaceVariant">@color/marconi_background</item>
        <item name="colorOnSurfaceVariant">@color/marconi_muted</item>
        <item name="colorOutline">@color/marconi_border</item>
        <item name="colorOutlineVariant">@color/marconi_border</item>
        <item name="android:statusBarColor">@color/marconi_background</item>
        <item name="android:navigationBarColor">@color/marconi_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Marconi.Title</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Marconi.Heading</item>
    </style>

    <style name="Theme.Marconi.Viewer" parent="Theme.Marconi">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="TextAppearance.Marconi.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/nebula_sans_black</item>
        <item name="android:fontFamily">@font/nebula_sans_black</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="TextAppearance.Marconi.Heading" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/nebula_sans_semibold</item>
        <item name="android:fontFamily">@font/nebula_sans_semibold</item>
    </style>

    <!-- The viewer's top bar in landscape, slimmer so more of the other computer's screen shows -->
    <style name="TextAppearance.Marconi.Heading.Compact">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Marconi.Subtitle.Compact" parent="TextAppearance.Marconi.Heading">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Marconi.Heading" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Marconi.Heading</item>
        <item name="android:textColor">@color/marconi_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Marconi.Muted" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/marconi_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
