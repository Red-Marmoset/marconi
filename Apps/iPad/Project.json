{
    "name": "Marconi",
    "type": "tool",
    "description": "Marconi for iPad and iPhone: the viewer core with a UIKit screen, generated as an Xcode project.",
    "compiler": "clang",
    "modules": [
        "MarconiCore"
    ],
    "sources": [
        "Marconi_iOS.mm"
    ],
    "resources": [
        "Assets.xcassets"
    ],
    "xcode": {
        "infoPlist": "Info.plist",
        "bundleIdentifier": "com.RedMarmosetStudios.Marconi",
        "developmentTeam": "RHL5BSNMJW",
        "versionFrom": "../../Project.json",
        "deploymentTarget": "15.0",
        "deviceFamily": "1,2",
        "objcArc": true,
        "frameworks": [
            "UIKit",
            "Foundation",
            "CoreGraphics",
            "QuartzCore"
        ],
        "includePaths": [
            "../../Modules"
        ]
    }
}
