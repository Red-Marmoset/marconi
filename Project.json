{
    "name": "Marconi",
    "type": "windowed",
    "version": "0.9.13",
    "description": "Marconi - cross-platform VNC client",
    "modules": [
        "MarconiCore",
        "MarconiUI"
    ],
    "compiler": "msvc",
    "package": {
        "displayName": "Marconi",
        "publisher": "Red Marmoset Studios Ltd.",
        "build": "Build.ps1",
        "files": [
            {
                "from": "Assets/Fonts/NebulaSans-Black.ttf",
                "to": "NebulaSans-Black.ttf"
            },
            {
                "from": "Assets/Fonts/NebulaSans-Semibold.ttf",
                "to": "NebulaSans-Semibold.ttf"
            },
            {
                "from": "Assets/Fonts/NebulaSans-LICENSE.txt",
                "to": "NebulaSans-LICENSE.txt"
            }
        ],
        "license": "LICENSE",
        "installerScript": "Installer/Marconi.nsi",
        "nsisPlugins": [
            "ShellExecAsUser"
        ],
        "outputDir": "Build/Installer",
        "zip": false
    },
    "signing": {
        "windows": {
            "thumbprintEnv": "MARCONI_SIGN_THUMBPRINT"
        },
        "macos": {
            "identityEnv": "MARCONI_SIGN_IDENTITY",
            "notaryProfileEnv": "MARCONI_NOTARY_PROFILE"
        },
        "android": {
            "keystoreEnv": "MARCONI_ANDROID_KEYSTORE",
            "keystorePasswordEnv": "MARCONI_ANDROID_KEYSTORE_PASSWORD",
            "keyAliasEnv": "MARCONI_ANDROID_KEY_ALIAS",
            "keyPasswordEnv": "MARCONI_ANDROID_KEY_PASSWORD"
        },
        "linux": {
            "maintainerEnv": "MARCONI_DEB_MAINTAINER"
        }
    }
}
