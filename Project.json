{
    "name": "Marconi",
    "type": "windowed",
    "version": "0.11.19",
    "description": "Marconi - cross-platform VNC client",
    "modules": [
        "MarconiCore",
        "MarconiUI"
    ],
    "compiler": "msvc",
    "package": {
        "displayName": "Marconi",
        "publisher": "Red Marmoset Studios Ltd.",
        "iconImage": "Assets/AppIcon.png",
        "accentColour": "#B22234",
        "titleFont": "Assets/Fonts/NebulaSans-Black.ttf",
        "textFont": "Assets/Fonts/NebulaSans-Semibold.ttf",
        "build": "Build.ps1",
        "files": [
            {
                "from": "Assets/Fonts/NebulaSans-Black.ttf",
                "to": "NebulaSans-Black.ttf"
            },
            {
                "from": "Assets/Fonts/NebulaSans-Semibold.ttf",
                "to": "NebulaSans-Semibold.ttf"
            },
            {
                "from": "Assets/Fonts/NebulaSans-LICENSE.txt",
                "to": "NebulaSans-LICENSE.txt"
            }
        ],
        "buildFiles": [
            "MarconiMcp.exe",
            "Apps.json",
            "marconi.mcpb"
        ],
        "license": "LICENSE",
        "icon": "Modules/MarconiUI/Resources/Marconi.ico",
        "wizardBitmap": "Installer/Art/Wizard.bmp",
        "headerBitmap": "Installer/Art/Header.bmp",
        "installerInclude": "Installer/Marconi.nsh",
        "nsisPlugins": [
            "ShellExecAsUser"
        ],
        "outputDir": "Build/Installer",
        "zip": false,
        "windows": {
            "installFor": "choice",
            "closeRunningApp": true,
            "licenseTicked": true,
            "desktopShortcut": "unticked",
            "startMenuShortcut": "optional",
            "sourceUrl": "https://github.com/Red-Marmoset/marconi",
            "sourceUrlText": "Open the source code on GitHub",
            "urlProtocols": [
                {
                    "scheme": "vnc",
                    "description": "URL:VNC connection"
                }
            ],
            "componentFiles": [
                "MarconiMcp.exe",
                "Apps.json",
                "marconi.mcpb"
            ],
            "files": [
                {
                    "from": "Assets/Fonts/NebulaSans-Black.ttf",
                    "to": "NebulaSans-Black.ttf"
                },
                {
                    "from": "Assets/Fonts/NebulaSans-Semibold.ttf",
                    "to": "NebulaSans-Semibold.ttf"
                },
                {
                    "from": "Assets/Fonts/NebulaSans-LICENSE.txt",
                    "to": "NebulaSans-LICENSE.txt"
                },
                {
                    "from": "LICENSE",
                    "to": "LICENSE.txt"
                }
            ]
        },
        "macos": {
            "iconImage": "Assets/AppIcon-macOS.png",
            "bundleIdentifier": "com.redmarmosetstudios.marconi",
            "infoPlist": "Installer/macOS/Info.plist",
            "category": "public.app-category.utilities",
            "buildFiles": [
                "MarconiMcp",
                "Apps.json"
            ],
            "beforeSigning": "Installer/macOS/BeforeSigning.sh"
        }
    },
    "signing": {
        "windows": {
            "thumbprintEnv": "MARCONI_SIGN_THUMBPRINT"
        },
        "macos": {
            "identityEnv": "MARCONI_SIGN_IDENTITY",
            "notaryProfileEnv": "MARCONI_NOTARY_PROFILE"
        },
        "android": {
            "keystoreEnv": "MARCONI_ANDROID_KEYSTORE",
            "keystorePasswordEnv": "MARCONI_ANDROID_KEYSTORE_PASSWORD",
            "keyAliasEnv": "MARCONI_ANDROID_KEY_ALIAS",
            "keyPasswordEnv": "MARCONI_ANDROID_KEY_PASSWORD"
        },
        "linux": {
            "maintainerEnv": "MARCONI_DEB_MAINTAINER"
        }
    }
}
