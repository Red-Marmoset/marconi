<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copyright (c) 2026 Red Marmoset Studios Ltd. -->
<!-- "Marconi Server.app"'s own Info.plist entries: a menu-bar program with no Dock icon (LSUIElement). The Una
     engine's Packaging/PackageProject.sh starts from this and adds the executable, icon, version, bundle identifier,
     category and minimum macOS from ServerUI/Project.json and the build. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Marconi Server</string>
    <!-- A different identifier from the viewer's: macOS keeps the Screen Recording and Accessibility permissions
         per identifier (and per signing identity), so the server is allowed on its own. -->
    <key>CFBundleName</key>
    <string>Marconi Server</string>
    <!-- A menu-bar program: no Dock icon and no menu bar of its own, only the icon in the menu bar. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright (c) 2026 Red Marmoset Studios Ltd.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
</dict>
</plist>
