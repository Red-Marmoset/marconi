<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copyright (c) 2026 Red Marmoset Studios Ltd. -->
<!-- Marconi.app's own Info.plist entries. The Una engine's Packaging/PackageProject.sh starts from this and adds the
     executable, icon, version, bundle identifier and minimum macOS from Project.json and the build. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>Marconi</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>VNC connection</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>vnc</string>
            </array>
        </dict>
    </array>
    <key>CFBundleName</key>
    <string>Marconi</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright (c) 2026 Red Marmoset Studios Ltd.</string>
    <!-- macOS 15 asks before an app connects to devices on the local network; this is the reason it shows. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Marconi connects to VNC and Screen Sharing servers on your local network.</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
</dict>
</plist>
