{
    "name": "MarconiCore",
    "version": "0.1.0",
    "type": "Engine",
    "description": "Headless VNC/RFB client core: sockets, protocol, decoders. Uses wx's bundled zlib on desktop (the system's on iOS and Android) and stb_image (JPEG) but no wx headers.",
    "dependencies": ["Platform", "Log", "Crypto"],
    "externalDependencies": ["wxwidgets", "stb", "json"],
    "platformLibraries": {
        "Windows": ["ws2_32.lib"],
        "iOS": ["-lz"],
        "Android": ["z", "log"]
    },
    "platforms": ["Windows", "Linux", "macOS", "iOS", "Android"]
}
