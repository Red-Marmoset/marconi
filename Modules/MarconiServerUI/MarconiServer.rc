// Copyright (c) 2026 Red Marmoset Studios Ltd.
// Windows resources for the Marconi Server tray program: its icon, version information and manifest (the newer Windows
// controls, and awareness of high-resolution screens). BuildTool compiles this with rc.exe on Windows.

#include <winver.h>

#include <MarconiCore/BuildVersion.h>

// Explorer, shortcuts and the taskbar use the icon with the lowest ID. Tools/make_app_icon.py renders it.
1 ICON "Resources/MarconiServer.ico"

// Built into the program, so it travels with it: the linker's own manifest is a separate file the installer doesn't
// ship. Without this one Windows treats the program as unaware of high-resolution screens (it shows only the
// top-left part of a scaled screen), and wxWidgets warns that the old Windows controls are in use. 1 and 24 are
// CREATEPROCESS_MANIFEST_RESOURCE_ID and RT_MANIFEST.
1 24 "Resources/MarconiServer.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MARCONI_VERSION_MAJOR, MARCONI_VERSION_MINOR, MARCONI_VERSION_PATCH, MARCONI_VERSION_REVISION
PRODUCTVERSION MARCONI_VERSION_MAJOR, MARCONI_VERSION_MINOR, MARCONI_VERSION_PATCH, MARCONI_VERSION_REVISION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "Red Marmoset Studios Ltd."
            VALUE "FileDescription", "Marconi Server"
            VALUE "FileVersion", MARCONI_VERSION_STRING
            VALUE "InternalName", "MarconiServer"
            VALUE "LegalCopyright", "Copyright (c) 2026 Red Marmoset Studios Ltd."
            VALUE "OriginalFilename", "MarconiServerTray.exe"
            VALUE "ProductName", "Marconi Server"
            VALUE "ProductVersion", MARCONI_VERSION_STRING
            VALUE "Comments", MARCONI_VERSION_COMMIT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1200
    END
END
